on fs
    wait /dev/block/by-name/persist 5
    mkdir /mnt/vendor/persist 0771 root system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist ro noatime nosuid nodev noload
    # The secure-element/Weaver TAs are needed before Android data decryption.
    # Audio's post-decrypt firmware mount is too late for these consumers.
    mkdir /vendor/firmware_mnt 0755 root root
    wait /dev/block/by-name/modem${ro.boot.slot_suffix} 5
    mount vfat /dev/block/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro noatime nosuid nodev
    setprop vendor.aera.crypto.firmware_ready 1
    start vendor.qseecomd

service vendor.qseecomd /vendor/bin/qseecomd
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    socket notify-topology stream 660 system drmrpc
    class core
    disabled
    user root
    group root drmrpc
    seclabel u:r:recovery:s0

on property:vendor.car.hiber=hiberExit
   stop vendor.qseecomd
   start vendor.qseecomd

service aera-crypto-prepare /system/bin/sh /vendor/bin/aera-crypto-prepare
    class core
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
