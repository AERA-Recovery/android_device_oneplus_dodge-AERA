service vendor.secure_element /vendor/bin/hw/android.hardware.secure_element-service.qti
    class hal
    disabled
    user root
    group nfc root
    seclabel u:r:recovery:s0

    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/vendor/odm/lib64

on property:vendor.aera.crypto.consumers_ready=1 && property:vendor.sys.listeners.registered=true
    start vendor.secure_element
